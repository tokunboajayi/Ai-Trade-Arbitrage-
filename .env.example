# ============================================
# AI HEDGE FUND - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ---- Kalshi ----
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./keys/kalshi_private.pem
KALSHI_ENV=demo  # demo | live

# ---- Polymarket ----
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_ENV=test  # test | live

# ---- Solana ----
SOLANA_PRIVATE_KEY=
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_ENV=devnet  # devnet | mainnet

# ---- Telegram Alerts ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- LLM (for sentiment/analysis agents only) ----
GEMINI_API_KEY=

# ---- System ----
LOG_LEVEL=INFO
DATA_DIR=./data
PAPER_TRADE=true  # ALWAYS start in paper trade mode
